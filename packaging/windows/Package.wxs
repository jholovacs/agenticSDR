<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Agentic SDR"
           Manufacturer="Jeremy Holovacs"
           Version="$(var.ProductVersion)"
           UpgradeCode="7c4e9a18-6b2d-4f5a-9c31-2e8d4b7a1f60"
           Compressed="yes">
    <SummaryInformation Description="Receive-only amateur radio listener" />
    <!-- Stable UpgradeCode + rising Version = in-place upgrade: stop service, replace files, keep ProgramData.
         Do not set AllowSameVersionUpgrades — that triggers ICE61 (Maximum version >= current). -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of Agentic SDR is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="LLMBASE" Value="https://api.openai.com/v1" Secure="yes" />
    <Property Id="LLMMODEL" Value="gpt-4o-mini" Secure="yes" />
    <Property Id="LLMKEY" Secure="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AgenticSDR" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CommonDataFolder" Name="AgenticSDR">
        <Component Id="CommonDataDir" Guid="a8c3e5f1-2b47-4d90-9e16-7f3a5c8d1b02">
          <!-- Do not RemoveFolder: llm.json must survive MajorUpgrade (old product uninstall). -->
          <CreateFolder />
          <RegistryValue Root="HKLM" Key="Software\AgenticSDR" Name="commonData" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu" Guid="b1e6c4a2-8d37-4f90-a15c-6e2b9d0f4c77">
        <!-- The API runs as a Windows service; the shortcut only opens the local page. -->
        <Shortcut Id="StartShortcut"
                  Name="Agentic SDR"
                  Description="Open the Agentic SDR page (API runs as a Windows service)"
                  Target="[WindowsFolder]explorer.exe"
                  Arguments="http://127.0.0.1:5088" />
        <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\AgenticSDR" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)**">
        <!-- Host exe is authored below with ServiceInstall. -->
        <Exclude Files="$(var.PublishDir)AgenticSdr.Host.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="HostService" Directory="INSTALLFOLDER" Guid="d4f1a9c7-6e28-4b3f-a0d5-9c1e7b4f2a86">
      <File Id="HostExe" Source="$(var.PublishDir)AgenticSdr.Host.exe" KeyPath="yes" />
      <ServiceInstall Id="AgenticSdrService"
                      Name="AgenticSdr"
                      DisplayName="Agentic SDR"
                      Description="Receive-only amateur radio API and web UI on http://127.0.0.1:5088"
                      Type="ownProcess"
                      Start="auto"
                      Account="LocalSystem"
                      ErrorControl="normal"
                      Vital="yes" />
      <ServiceControl Id="AgenticSdrServiceControl"
                      Name="AgenticSdr"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <Feature Id="Main" Title="Agentic SDR" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="HostService" />
      <ComponentRef Id="CommonDataDir" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Dialog Id="LlmDlg" Width="370" Height="270" Title="Agentic SDR">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="16" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}OpenAI connection" />
        <Control Id="Description" Type="Text" X="20" Y="36" Width="330" Height="32" Transparent="yes" NoPrefix="yes" Text="The page can ask a model that speaks the OpenAI chat protocol. A local server such as http://127.0.0.1:11434/v1 works too. The key stays on this computer and is sent only to that endpoint." />
        <Control Id="BaseLabel" Type="Text" X="20" Y="74" Width="330" Height="12" NoPrefix="yes" Text="Endpoint" />
        <Control Id="Base" Type="Edit" X="20" Y="88" Width="330" Height="18" Property="LLMBASE" />
        <Control Id="ModelLabel" Type="Text" X="20" Y="114" Width="330" Height="12" NoPrefix="yes" Text="Model" />
        <Control Id="Model" Type="Edit" X="20" Y="128" Width="330" Height="18" Property="LLMMODEL" />
        <Control Id="KeyLabel" Type="Text" X="20" Y="154" Width="330" Height="12" NoPrefix="yes" Text="API key (optional)" />
        <Control Id="Key" Type="Edit" X="20" Y="168" Width="330" Height="18" Property="LLMKEY" Password="yes" />
        <Control Id="Note" Type="Text" X="20" Y="196" Width="330" Height="28" Transparent="yes" NoPrefix="yes" Text="The API installs as a Windows service with librtlsdr included. Next, the installer downloads the small English speech model if needed." />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <!-- Fresh install: directory → LLM → ready. Upgrade: keep dir + llm.json; skip to ready. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="WIX_UPGRADE_DETECTED" Order="6" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="LlmDlg" Order="5" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Condition="WIX_UPGRADE_DETECTED" Order="6" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="LlmDlg" Condition="NOT WIX_UPGRADE_DETECTED" Order="5" />
    </UI>

    <!-- Write llm.json under ProgramData so the LocalSystem service can read it (fresh install only). -->
    <SetProperty Id="ApplyLlm"
                 Value="&quot;[INSTALLFOLDER]AgenticSdr.Host.exe&quot; --set-llm --path &quot;[CommonDataFolder]llm.json&quot; --base &quot;[LLMBASE]&quot; --model &quot;[LLMMODEL]&quot; --key &quot;[LLMKEY]&quot;"
                 Before="ApplyLlm"
                 Sequence="execute"
                 Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REMOVE~=&quot;ALL&quot;" />
    <CustomAction Id="ApplyLlm"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[CustomActionData]"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <SetProperty Id="ApplyFetch"
                 Value="&quot;[INSTALLFOLDER]AgenticSdr.Host.exe&quot; --fetch-native --home &quot;[INSTALLFOLDER]&quot;"
                 Before="ApplyFetch"
                 Sequence="execute"
                 Condition="NOT REMOVE~=&quot;ALL&quot;" />
    <CustomAction Id="ApplyFetch"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[CustomActionData]"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <InstallExecuteSequence>
      <!-- Finish setup before StartServices brings the API up. Never rewrite llm.json on upgrade (empty key would clear it). -->
      <Custom Action="ApplyLlm" After="InstallFiles" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="ApplyFetch" After="ApplyLlm" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
