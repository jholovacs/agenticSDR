# Root native/ holds Lime builds and toolchain caches — not committed.
# Tracked: MIT crates, GPL-2 libm17, and Windows librtlsdr DLLs (rtlsdr + deps).
/native/*
!/native/m17voice/
!/native/m17voice/**
!/native/xaramonitor/
!/native/xaramonitor/**
!/native/libm17/
!/native/libm17/**
!/native/rtlsdr.dll
!/native/pthreadVC2.dll
!/native/msvcr100.dll
native/**/target/
native/libm17/build/

